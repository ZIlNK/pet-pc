{
  "id": "pet-bubble",
  "name": "Desktop Pet Bubble",
  "description": "Local channel that routes OpenClaw Agent replies to desktop pet instances",
  "kind": "channel",
  "activation": {
    "onStartup": true
  },
  "channels": ["pet-bubble"],
  "channelEnvVars": {
    "pet-bubble": []
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "pet-bubble": {
      "schema": {
        "type": "object",
        "properties": {
          "webhookPath": {
            "type": "string",
            "default": "/pet-bubble-webhook"
          },
          "webhookHost": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "webhookPort": {
            "type": "integer",
            "default": 0
          },
          "desktopApiBase": {
            "type": "string",
            "default": "http://127.0.0.1:8080/api"
          },
          "sharedSecret": {
            "type": "string",
            "default": ""
          },
          "autoReply": {
            "type": "boolean",
            "default": true,
            "description": "Deliver Agent replies to the Desktop Pet API"
          }
        }
      },
      "uiHints": {
        "sharedSecret": {
          "sensitive": true,
          "label": "Shared secret"
        }
      }
    }
  }
}
